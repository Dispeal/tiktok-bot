# Copy to .env (local) or paste into Railway > Variables. Never commit real values.

# One bot per client, from @BotFather
CLIENT_A_BOT_TOKEN=
CLIENT_B_BOT_TOKEN=

# For AI captions (console.anthropic.com). Leave empty to post the clipper's own caption.
ANTHROPIC_API_KEY=

# Residential proxy for TikTok, e.g. http://user:pass@gate.provider.com:7777
PROXY_URL=
# false = only account checks use the proxy, video downloads go direct (saves proxy GB)
PROXY_DOWNLOADS=true

# Optional
# CONFIG_PATH=config.yaml
# DATABASE_PATH=/data/clipbot.db
# TIKTOK_COOKIES_FILE=cookies.txt
# LOG_LEVEL=INFO
